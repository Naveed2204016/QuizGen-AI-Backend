APP_NAME=QuizGen AI API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TIMEOUT_SECONDS=8

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=quizgen_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

MAX_UPLOAD_MB=20
QUESTION_GENERATION_TIMEOUT_SECONDS=10
ANSWER_EVALUATION_TIMEOUT_SECONDS=10