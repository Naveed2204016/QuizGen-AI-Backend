APP_NAME=QuizGen AI API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=quizgen_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

MAX_UPLOAD_MB=20
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
QUESTION_GENERATION_TIMEOUT_SECONDS=10
ANSWER_EVALUATION_TIMEOUT_SECONDS=10
